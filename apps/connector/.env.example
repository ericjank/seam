SEAM_PLATFORM_URL=http://localhost:3000
SEAM_AGENT_ID=replace-me
SEAM_AGENT_TOKEN=replace-me
SEAM_PROJECT_ROOT=/path/to/private/project
SEAM_ADAPTER=codex-app-server
SEAM_POLL_INTERVAL_MS=1000
# SEAM_CLAUDE_COMMAND=claude
# SEAM_CODEX_COMMAND=codex
# 默认只读。允许 Connector 在本项目实施/测试时，由本机维护者明确改为 workspace-write。
# 平台任务不能修改此策略，遇到沙箱限制仍须由本机维护者处理。
SEAM_CODEX_SANDBOX=read-only
# 需要在Agent侧调用业务HTTP联调时，由本机维护者一次配置；仅已批准executing轮次生效。
# 规划/确认阶段始终禁用网络。
SEAM_CODEX_NETWORK_ACCESS=false
# 可选，默认 ~/.seam/threads。只保存本协作的线程映射；勿放进源码仓库。
# SEAM_APP_SERVER_STATE_DIR=/path/to/private/seam-threads
# SEAM_GENERIC_AGENT_COMMAND=/path/to/agent
# SEAM_GENERIC_AGENT_ARGS=[]
# SEAM_TEST_COMMAND=pnpm test:contract
