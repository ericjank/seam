{
  "name": "seam",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @seam/platform dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @seam/platform test:e2e",
    "test:integration": "pnpm --filter @seam/platform test:integration",
    "db:generate": "pnpm --filter @seam/platform db:generate",
    "db:migrate": "pnpm --filter @seam/platform db:migrate",
    "simulation:up": "docker compose -f docker-compose.simulation.yml up -d --build --wait",
    "test:simulation": "pnpm --filter @seam/connector... build && node scripts/simulation/run.mjs",
    "test:lifecycle": "pnpm --filter @seam/platform exec tsx tests/lifecycle-integration.ts",
    "test:simulation:fixtures": "node --test scripts/simulation/joint-fixture.test.mjs",
    "test:simulation:poll-recovery": "node scripts/simulation/poll-recovery.mjs",
    "test:simulation:cancel": "pnpm --filter @seam/connector... build && node scripts/simulation/cancellation.mjs",
    "test:simulation:recovery": "pnpm --filter @seam/connector... build && node scripts/simulation/recovery.mjs",
    "test:simulation:regression": "docker compose -f docker-compose.simulation.yml exec -T app node scripts/simulation/regression.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
